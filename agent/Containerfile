FROM docker.io/library/python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY agent.py .
COPY config.py .

RUN useradd \
    --create-home \
    --shell /usr/sbin/nologin \
    monitoring

USER monitoring

CMD ["python", "agent.py"]